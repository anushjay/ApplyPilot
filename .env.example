# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# Privacy / security defaults
APPLYPILOT_PRIVACY_MODE=strict
# APPLYPILOT_ALLOW_CLOUD_LLM=1       # Required before Gemini/OpenAI/Claude receive resume/profile data
# APPLYPILOT_ENABLE_GMAIL_MCP=1      # Optional: allow Claude to read/search Gmail verification emails
# APPLYPILOT_ALLOW_VULNERABLE_GMAIL_MCP=1  # Required too; current Gmail MCP has vulnerable transitive deps
# APPLYPILOT_ENABLE_CAPSOLVER=1      # Optional: include CapSolver key in the live Claude prompt
# APPLYPILOT_CLONE_CHROME_PROFILE=1  # Optional: seed worker Chrome profiles from your real Chrome profile

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
